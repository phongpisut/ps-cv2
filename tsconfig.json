{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "strict": true, "types": ["vite/client", "@webgpu/types"],
    "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src"]
}
